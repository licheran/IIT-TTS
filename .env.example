# Copy to .env and edit. .env is never committed.

# --- Database (docker compose `db` service) ---
POSTGRES_USER=tts
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tts

# --- Backend (spec 06 section 9) ---
# Inside compose the host is `db`. From the host machine use localhost:5432.
TT_DATABASE_URL=postgresql+psycopg://tts:change-me@db:5432/tts
# Single admin account. Used from Phase 6 (auth); empty until then.
TT_ADMIN_USER=admin
TT_ADMIN_PASSWORD_HASH=
# Number of solver worker processes.
TT_WORKERS=1

# --- Tests (optional): run the integration tests against Postgres instead of SQLite ---
# TT_TEST_PG=postgresql+psycopg://tts:change-me@localhost:5432/tts_test

# --- Web ---
# URL the browser uses to reach the API.
VITE_API_URL=http://localhost:8000
